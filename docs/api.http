### Steward walkthrough (VS Code REST Client / JetBrains HTTP client)
### Phase 2: every API call needs credentials. Start the server; on first boot it prints a generated
### admin password (or set STEWARD_ADMIN_PASSWORD before the first boot).
@base = http://127.0.0.1:3000
@adminPassword = change-me

### Health (public)
GET {{base}}/health

### 0. Log in as admin -> copy result.token into @token
# @name login
POST {{base}}/api/steward/auth/login
Content-Type: application/json

{ "user_name": "admin", "password": "{{adminPassword}}" }

###
@token = {{login.response.body.result.token}}

### Who am I?
GET {{base}}/api/steward/auth/me
Authorization: Bearer {{token}}

### 1. Create the root "task" table
POST {{base}}/api/steward/meta/tables
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "task",
  "fields": [
    { "element": "number", "type": "string" },
    { "element": "short_description", "type": "string", "maxLength": 160, "mandatory": true },
    { "element": "priority", "type": "integer", "defaultValue": 4 },
    { "element": "state", "type": "choice", "defaultValue": "new",
      "choices": [ { "value": "new", "label": "New" }, { "value": "closed", "label": "Closed" } ] },
    { "element": "assigned_to", "type": "reference", "reference": "sys_user" },
    { "element": "caller", "type": "reference", "reference": "sys_user" },
    { "element": "work_notes", "type": "text" }
  ]
}

### 2. Extend it: incident (auto-numbered INC...)
POST {{base}}/api/steward/meta/tables
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "incident", "extends": "task", "numberPrefix": "INC" }

### 3. Inspect the resolved schema (inherited fields, storage columns)
GET {{base}}/api/steward/meta/tables/incident
Authorization: Bearer {{token}}

### 4. Create a role "itil" -> note its sys_id
POST {{base}}/api/now/table/sys_user_role
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "itil" }

### 5. Create two users (passwords are hashed and never returned)
POST {{base}}/api/now/table/sys_user
Authorization: Bearer {{token}}
Content-Type: application/json

{ "user_name": "alice", "first_name": "Alice", "user_password": "alice-pw" }

###
POST {{base}}/api/now/table/sys_user
Authorization: Bearer {{token}}
Content-Type: application/json

{ "user_name": "carol", "first_name": "Carol", "user_password": "carol-pw" }

### 6. Give alice the itil role
POST {{base}}/api/now/table/sys_user_has_role
Authorization: Bearer {{token}}
Content-Type: application/json

{ "user": "<alice sys_id>", "role": "<itil sys_id>" }

### 7. ACLs (admin has security_admin): itil reads all tasks; everyone reads tasks where they are the caller;
###    only itil reads work_notes. Then link roles via sys_security_acl_role.
POST {{base}}/api/now/table/sys_security_acl
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "task", "operation": "read", "description": "itil reads all tasks" }

###
POST {{base}}/api/now/table/sys_security_acl_role
Authorization: Bearer {{token}}
Content-Type: application/json

{ "sys_security_acl": "<acl sys_id from above>", "sys_user_role": "<itil sys_id>" }

###
POST {{base}}/api/now/table/sys_security_acl
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "task", "operation": "read", "condition": "caller=javascript:gs.getUserID()", "description": "callers read their own" }

###
POST {{base}}/api/now/table/sys_security_acl
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "task.work_notes", "operation": "read", "description": "itil only" }

###
POST {{base}}/api/now/table/sys_security_acl_role
Authorization: Bearer {{token}}
Content-Type: application/json

{ "sys_security_acl": "<work_notes acl sys_id>", "sys_user_role": "<itil sys_id>" }

### 8. Create incidents (one with carol as caller)
POST {{base}}/api/now/table/incident
Authorization: Bearer {{token}}
Content-Type: application/json

{ "short_description": "Carol's printer", "caller": "<carol sys_id>", "work_notes": "VIP" }

###
POST {{base}}/api/now/table/incident
Authorization: Bearer {{token}}
Content-Type: application/json

{ "short_description": "Someone else's VPN", "work_notes": "internal" }

### 9. Same query, different users (Basic auth: alice:alice-pw / carol:carol-pw)
GET {{base}}/api/now/table/incident?sysparm_fields=number,short_description,work_notes
Authorization: Basic alice:alice-pw

###
GET {{base}}/api/now/table/incident?sysparm_fields=number,short_description,work_notes
Authorization: Basic carol:carol-pw

### 10. Impersonate carol with the admin token, look, then stop
POST {{base}}/api/steward/auth/impersonate
Authorization: Bearer {{token}}
Content-Type: application/json

{ "user_name": "carol" }

###
GET {{base}}/api/now/table/incident?sysparm_fields=number,short_description
Authorization: Bearer {{token}}

###
DELETE {{base}}/api/steward/auth/impersonate
Authorization: Bearer {{token}}

### 11. Dot-walk + display values, optimistic update, audit (as admin)
GET {{base}}/api/now/table/incident?sysparm_query=priority<=4^ORDERBYDESCsys_created_on&sysparm_fields=number,caller,caller.user_name,state&sysparm_display_value=true
Authorization: Bearer {{token}}

###
PATCH {{base}}/api/now/table/incident/<sys_id>
Authorization: Bearer {{token}}
Content-Type: application/json
If-Match: "0"

{ "priority": 1 }

###
GET {{base}}/api/now/table/sys_audit?sysparm_query=documentkey=<sys_id>^ORDERBYrecord_checkpoint&sysparm_fields=fieldname,oldvalue,newvalue,user,record_checkpoint
Authorization: Bearer {{token}}

### 12. Log out
POST {{base}}/api/steward/auth/logout
Authorization: Bearer {{token}}

### ------------------------------------------------------------------ Phase 3: UI API
### The web UI (http://127.0.0.1:3000/now/nav after `npm run build`) uses these endpoints
### with an HttpOnly cookie session; with a bearer token they work the same way.

### Navigator: tables the caller may read
GET {{base}}/api/steward/ui/nav
Authorization: Bearer {{token}}

### List layout (sys_ui_list, inherited from parent tables, or generated from the dictionary)
GET {{base}}/api/steward/ui/list/incident?sysparm_view=default
Authorization: Bearer {{token}}

### Form layout for a new record (defaults + create access per field)
GET {{base}}/api/steward/ui/form/incident?sys_id=-1
Authorization: Bearer {{token}}

### Save a list layout (columns may dot-walk)
POST {{base}}/api/now/table/sys_ui_list
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "incident", "view": "default", "elements": "number,short_description,caller.name,priority" }

### Journal field: add one, then write to it (each value becomes a sys_journal_field entry)
POST {{base}}/api/steward/meta/tables/task/fields
Authorization: Bearer {{token}}
Content-Type: application/json

{ "element": "comments", "type": "journal" }

### Activity stream of a record (journal entries + audited changes, ACL-filtered)
# GET {{base}}/api/steward/ui/activity/incident/<sys_id>
# Authorization: Bearer {{token}}

### ------------------------------------------------------------------ Phase 4: Server Scripting
### Business Rules (sys_script), Script Includes (sys_script_include), scripted ACLs
### (sys_security_acl.script), and Background Scripts (/api/steward/script/eval).

### Create a reusable Script Include (Class.create)
POST {{base}}/api/now/table/sys_script_include
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "IncidentHelper",
  "script": "var IncidentHelper = Class.create(); IncidentHelper.prototype = { initialize: function() {}, tag: function(s) { return '[P1] ' + s; }, type: 'IncidentHelper' };"
}

### Create a before-insert/update Business Rule on incident
POST {{base}}/api/now/table/sys_script
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Tag P1 Incidents",
  "collection": "incident",
  "when": "before",
  "order": 100,
  "action_insert": true,
  "action_update": true,
  "filter_condition": "priority=1",
  "script": "var h = new IncidentHelper(); if (String(current.short_description).indexOf('[P1] ') !== 0) { current.short_description = h.tag(current.short_description); }"
}

### Run a background script in the V8 sandbox (admin only)
POST {{base}}/api/steward/script/eval
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "script": "var gr = new GlideRecord('incident'); gr.addQuery('priority', 1); gr.query(); gs.info('P1 count = ' + gr.getRowCount()); gr.getRowCount();"
}

### Inspect recent script logs (gs.info / warn / error / debug)
GET {{base}}/api/steward/script/logs
Authorization: Bearer {{token}}

### ------------------------------------------------------------------ Phase 5: Events, Jobs, Notifications & Client Logic
### Transactional outbox (sys_event + gs.eventQueue), Script Actions (sysevent_script_action),
### Scheduled Jobs (sys_trigger), Email Notifications (sysevent_email_action -> sys_email),
### Client Scripts (sys_script_client), and UI Policies (sys_ui_policy + sys_ui_policy_action).

### Create an Email Notification when an incident is assigned
POST {{base}}/api/now/table/sysevent_email_action
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Incident Assigned",
  "collection": "incident",
  "when_to_send": "record",
  "action_insert": true,
  "action_update": true,
  "filter_condition": "assigned_toISNOTEMPTY",
  "condition": "current.changes('assigned_to')",
  "recipient_fields": "assigned_to",
  "subject": "[${number}] Assigned to ${assigned_to.name}: ${short_description}",
  "message_text": "Hello ${assigned_to.first_name}, incident ${number} has been assigned to you: ${URI}"
}

### Create an onChange Client Script on incident.priority
POST {{base}}/api/now/table/sys_script_client
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Highlight P1 Priority",
  "table": "incident",
  "type": "onChange",
  "field_name": "priority",
  "script": "function onChange(control, oldValue, newValue) { if (newValue === '1') { g_form.setMandatory('assigned_to', true); g_form.addInfoMessage('P1 incidents require an assignee'); } }"
}

### Create a Scheduled Job (cron / interval / once)
POST {{base}}/api/now/table/sys_trigger
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Periodic Incident Audit",
  "trigger_type": "cron",
  "cron_expression": "*/15 * * * *",
  "script": "var gr = new GlideRecord('incident'); gr.addQuery('priority', 1); gr.query(); gs.info('Open P1 incidents: ' + gr.getRowCount());"
}

### Trigger a worker tick immediately (runs due sys_trigger jobs + drains sys_event & sys_email)
POST {{base}}/api/steward/events/tick
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### Inspect delivered outbound emails
GET {{base}}/api/steward/events/outbox
Authorization: Bearer {{token}}

### ------------------------------------------------------------------ Phase 6 & 7: Scoped Apps, SDK, Flows & SLAs

### List installed application scopes
GET {{base}}/api/steward/apps
Authorization: Bearer {{token}}

### Generate TypeScript .d.ts definitions from the live dictionary
GET {{base}}/api/steward/apps/types?scope=global
Authorization: Bearer {{token}}



